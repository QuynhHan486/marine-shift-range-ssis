                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_DBDATE)(TOKEN(eventDate,"/",3) + "-" + RIGHT("0" + TOKEN(eventDate,"/",2),2) + "-" + RIGHT("0" + TOKEN(eventDate,"/",1),2))</property>
