                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_DBDATE)([TOKEN](#{Package\Load Dim_Date\Flat File Source.Outputs[Flat File Source Output].Columns[eventDate]},"/",3) + "-" + [RIGHT]("0" + [TOKEN](#{Package\Load Dim_Date\Flat File Source.Outputs[Flat File Source Output].Columns[eventDate]},"/",2),2) + "-" + [RIGHT]("0" + [TOKEN](#{Package\Load Dim_Date\Flat File Source.Outputs[Flat File Source Output].Columns[eventDate]},"/",1),2))</property>
