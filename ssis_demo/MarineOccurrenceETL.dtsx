                          name="Expression">[MONTH](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]})</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">MONTH(event_date)</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[decade]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="5"
                      lineageId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[decade]"
                      name="decade"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_WSTR,4)([YEAR](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) - [YEAR](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) % 10) + "s"</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_WSTR,4)(YEAR(event_date) - YEAR(event_date) % 10) + "s"</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[quarter]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="2"
                      lineageId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[quarter]"
                      name="quarter"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">"Q" + (DT_WSTR,1)[DATEPART]("quarter",#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]})</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">"Q" + (DT_WSTR,1)DATEPART("quarter",event_date)</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[season]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="6"
                      lineageId="Package\Load Dim_Date\Date Attributes.Outputs[Derived Column Output].Columns[season]"
                      name="season"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[MONTH](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) == 12 || [MONTH](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) &lt;= 2 ? "Winter" : ([MONTH](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) &lt;= 5 ? "Spring" : ([MONTH](#{Package\Load Dim_Date\Convert Date.Outputs[Derived Column Output].Columns[event_date]}) &lt;= 8 ? "Summer" : "Autumn"))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">MONTH(event_date) == 12 || MONTH(event_date) &lt;= 2 ? "Winter" : (MONTH(event_date) &lt;= 5 ? "Spring" : (MONTH(event_date) &lt;= 8 ? "Summer" : "Autumn"))</property>
                      </properties>
                    </outputColumn>
