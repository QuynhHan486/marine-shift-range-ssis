            <xs:element name="dbo_Dim_Location" msprop:DbTableName="Dim_Location" msprop:FriendlyName="Dim_Location" msprop:TableType="View" msprop:DbSchemaName="dbo" msprop:design-time-name="79ee1378-87a8-4643-928b-319d8d2741f4" msprop:QueryDefinition="SELECT l.*,&#10; CASE WHEN l.sss IS NULL THEN -1 WHEN l.sss &lt; 30 THEN 0 WHEN l.sss &lt; 32 THEN 1 ELSE 2 END AS sss_group_key,&#10; CAST(CASE WHEN l.sss IS NULL THEN N'Unknown SSS' WHEN l.sss &lt; 30 THEN N'&lt;30' WHEN l.sss &lt; 32 THEN N'30-32' ELSE N'&gt;=32' END AS nvarchar(64)) AS sss_group_caption,&#10; CASE WHEN l.shoredistance IS NULL THEN -1 WHEN l.shoredistance &lt; 0 THEN -2 WHEN l.shoredistance &lt; 10000 THEN 0 WHEN l.shoredistance &lt; 50000 THEN 1 ELSE 2 END AS shore_group_key,&#10; CAST(CASE WHEN l.shoredistance IS NULL THEN N'Unknown distance' WHEN l.shoredistance &lt; 0 THEN N'Inland (&lt;0 m)' WHEN l.shoredistance &lt; 10000 THEN N'0-10 km' WHEN l.shoredistance &lt; 50000 THEN N'10-50 km' ELSE N'&gt;=50 km' END AS nvarchar(64)) AS shore_group_caption,&#10; CAST(CONCAT(CONVERT(nvarchar(40),l.decimalLatitude),N',',CONVERT(nvarchar(40),l.decimalLongitude)) AS nvarchar(96)) AS coordinates_caption,&#10; CAST(COALESCE(NULLIF(LTRIM(RTRIM(l.country)),N''),N'Unknown country') AS nvarchar(128)) AS country_caption,&#10; CAST(COALESCE(NULLIF(LTRIM(RTRIM(l.sst_group)),N''),N'Unknown SST') AS nvarchar(64)) AS sst_group_caption&#10;FROM dbo.Dim_Location AS l">
